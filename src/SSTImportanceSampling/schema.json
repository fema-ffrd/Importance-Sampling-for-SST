{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SST Importance Sampling Configuration",
  "description": "Configuration schema for SST Importance Sampling preprocessor",
  "type": "object",
  "required": ["project", "paths", "output", "preprocess"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "description": "Project metadata",
      "required": ["name", "run_type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name (e.g., 'trinity', 'indian_creek')",
          "minLength": 1,
          "maxLength": 100
        },
        "run_type": {
          "type": "string",
          "description": "Run type identifier (e.g., 'sst_ais')",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "paths": {
      "type": "object",
      "description": "Input data file paths",
      "required": ["watershed_geojson", "domain_geojson", "dss_catalog"],
      "additionalProperties": false,
      "properties": {
        "watershed_geojson": {
          "type": "string",
          "description": "Path to watershed GeoJSON file (relative or absolute)"
        },
        "domain_geojson": {
          "type": "string",
          "description": "Path to domain GeoJSON file (relative or absolute)"
        },
        "dss_catalog": {
          "type": "string",
          "description": "Path to DSS files directory or catalog JSON file"
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Output configuration",
      "required": ["base_folder", "export_format"],
      "additionalProperties": false,
      "properties": {
        "base_folder": {
          "type": "string",
          "description": "Base output directory for all runs (relative or absolute)"
        },
        "export_format": {
          "type": "string",
          "enum": ["csv", "parquet"],
          "description": "Export format for output tables: 'csv' or 'parquet'",
          "default": "csv"
        }
      }
    },
    "preprocess": {
      "type": "object",
      "description": "Preprocessing configuration",
      "required": ["grid_spacing"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["force", "reuse", "auto"],
          "description": "Preprocessing mode: 'force' (always recompute), 'reuse' (require existing_run), 'auto' (reuse if exists, else compute)",
          "default": "auto"
        },
        "existing_run": {
          "type": ["string", "null"],
          "description": "Path to existing run folder for reuse/auto modes (relative or absolute)"
        },
        "grid_spacing": {
          "type": "number",
          "description": "Grid spacing in CRS units (typically meters for projected CRS)",
          "exclusiveMinimum": 0
        },
        "dss_variable_keyword": {
          "type": "string",
          "description": "DSS variable keyword filter (e.g., 'PRECIPITATION')",
          "default": "PRECIPITATION"
        },
        "dss_grid_keyword": {
          "type": "string",
          "description": "DSS grid keyword filter (e.g., 'SHG')",
          "default": "SHG"
        },
        "dss_max_workers": {
          "type": "integer",
          "description": "Number of parallel workers for DSS file processing (recommended: CPU_count, typical range: 4-16)",
          "minimum": 1,
          "maximum": 256,
          "default": 8
        },
        "random_seed": {
          "type": ["integer", "null"],
          "description": "Random seed for reproducibility (null = auto-generate random seed)",
          "minimum": 0
        },
        "netcdf_compression": {
          "type": "object",
          "description": "NetCDF output compression settings",
          "additionalProperties": false,
          "properties": {
            "zlib": {
              "type": "boolean",
              "description": "Enable NetCDF compression",
              "default": true
            },
            "complevel": {
              "type": "integer",
              "description": "Compression level (1=fast, 9=max compression)",
              "minimum": 1,
              "maximum": 9,
              "default": 4
            }
          }
        },
        "validity": {
          "type": "object",
          "description": "Storm placement validity checking configuration",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable validity checking of storm placements",
              "default": true
            },
            "export_format": {
              "type": "string",
              "enum": ["csv", "parquet"],
              "description": "Export format for validity results (defaults to output.export_format if not specified)"
            },
            "max_workers": {
              "type": "integer",
              "description": "Number of parallel workers for validity checking (recommended: 2-8, CPU_count / 2)",
              "minimum": 1,
              "maximum": 128,
              "default": 4
            },
            "fishnet_chunk_size": {
              "type": "integer",
              "description": "Fishnet grid chunk size for memory efficiency (smaller=less memory/slower; larger=more memory/faster, recommended: 10000-100000)",
              "minimum": 100,
              "maximum": 1000000,
              "default": 50000
            }
          }
        }
      }
    },
    "run_metadata": {
      "type": "object",
      "description": "Run metadata (auto-generated, do not edit)",
      "additionalProperties": true
    }
  }
}