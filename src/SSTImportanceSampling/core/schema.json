{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SST Importance Sampling Configuration",
  "description": "Configuration schema for SST Importance Sampling",
  "type": "object",
  "required": ["project", "global", "paths", "output", "preprocess", "sampling"],
  "additionalProperties": false,

  "properties": {

    "project": {
      "type": "object",
      "required": ["name", "run_type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "run_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },

    "global": {
      "type": "object",
      "required": ["random_seed"],
      "additionalProperties": false,
      "properties": {
        "random_seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Global random seed used for entire pipeline"
        }
      }
    },

    "paths": {
      "type": "object",
      "required": ["watershed_geojson", "domain_geojson", "dss_catalog"],
      "additionalProperties": false,
      "properties": {
        "watershed_geojson": { "type": "string" },
        "domain_geojson": { "type": "string" },
        "dss_catalog": { "type": "string" }
      }
    },

    "output": {
      "type": "object",
      "required": ["base_folder", "export_format"],
      "additionalProperties": false,
      "properties": {
        "base_folder": { "type": "string" },
        "export_format": {
          "type": "string",
          "enum": ["csv", "parquet"],
          "default": "csv",
          "description": "Single export format used across entire pipeline"
        }
      }
    },

    "preprocess": {
      "type": "object",
      "required": ["grid_spacing"],
      "additionalProperties": false,
      "properties": {

        "mode": {
          "type": "string",
          "enum": ["force", "reuse", "auto"],
          "default": "auto"
        },

        "existing_run": {
          "type": ["string", "null"]
        },

        "grid_spacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "dss_variable_keyword": {
          "type": "string",
          "default": "PRECIPITATION"
        },

        "dss_grid_keyword": {
          "type": "string",
          "default": "SHG"
        },

        "dss_max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "default": 8
        },

        "netcdf_compression": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zlib": {
              "type": "boolean",
              "default": true
            },
            "complevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9,
              "default": 4
            }
          }
        },

        "validity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "max_workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128,
              "default": 4
            },
            "fishnet_chunk_size": {
              "type": "integer",
              "minimum": 100,
              "maximum": 1000000,
              "default": 50000
            }
          }
        }
      }
    },

    "sampling": {
      "type": "object",
      "required": ["method", "n_events"],
      "additionalProperties": false,
      "properties": {

        "method": {
          "type": "string",
          "enum": ["uniform"],
          "description": "Sampling method"
        },

        "n_events": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of storm events to sample"
        }
      }
    },

    "run_metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}